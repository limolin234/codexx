{
  "roles": {
    "interactive_model": "fast-local-or-cheap",
    "main_model": "strong-main",
    "audit_model": "audit-cheap",
    "memory_model": "memory-cheap",
    "codex_model": "default"
  },
  "models": {
    "fast-local-or-cheap": {
      "provider": "openai_compatible",
      "model": "REPLACE_WITH_MODEL_NAME",
      "base_url": "https://api.example.com/v1",
      "api_key": "REPLACE_WITH_API_KEY_OR_USE_api_key_env",
      "api_key_env": "FAST_MODEL_API_KEY",
      "temperature": 0.2,
      "max_tokens": 120,
      "timeout_seconds": 20
    },
    "strong-main": {
      "provider": "openai_compatible",
      "model": "REPLACE_WITH_MODEL_NAME",
      "base_url": "https://api.example.com/v1",
      "api_key_env": "MAIN_MODEL_API_KEY",
      "temperature": 0.3,
      "max_tokens": 600,
      "timeout_seconds": 60
    },
    "audit-cheap": {
      "provider": "openai_compatible",
      "model": "REPLACE_WITH_MODEL_NAME",
      "base_url": "https://api.example.com/v1",
      "api_key_env": "AUDIT_MODEL_API_KEY",
      "temperature": 0,
      "max_tokens": 200,
      "timeout_seconds": 30
    },
    "memory-cheap": {
      "provider": "openai_compatible",
      "model": "REPLACE_WITH_MODEL_NAME",
      "base_url": "https://api.example.com/v1",
      "api_key_env": "MEMORY_MODEL_API_KEY",
      "temperature": 0,
      "max_tokens": 300,
      "timeout_seconds": 30
    }
