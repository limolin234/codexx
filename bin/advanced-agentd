#!/usr/bin/env bash
set -euo pipefail
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH="$LINK_TARGET" ;;
    *) SCRIPT_PATH="$SCRIPT_DIR/$LINK_TARGET" ;;
  esac
done
ROOT="$(cd -P "$(dirname "$SCRIPT_PATH")/.." && pwd)"
PY="$ROOT/.venv/bin/python"
if [ ! -s "$PY" ] || ! "$PY" -c 'import sys' >/dev/null 2>&1; then
  echo "advanced-agentd: missing or broken project virtualenv: $PY" >&2
  echo "advanced-agentd: run installer first: bash $ROOT/scripts/install.sh" >&2
  exit 1
fi
cd "$ROOT"
export VIRTUAL_ENV="$ROOT/.venv"
export PATH="$ROOT/.venv/bin:$PATH"
export PYTHONPATH="$ROOT/src:${PYTHONPATH:-}"
export ADVANCED_AGENT_PROJECT_ROOT="${ADVANCED_AGENT_PROJECT_ROOT:-$ROOT}"
export ADVANCED_AGENT_DB="${ADVANCED_AGENT_DB:-runtime/advanced_agent.sqlite}"
export ADVANCED_AGENT_CONFIG="${ADVANCED_AGENT_CONFIG:-.env.json}"
export ADVANCED_AGENT_SCOPE="${ADVANCED_AGENT_SCOPE:-project:advanced_agent}"
exec "$PY" -m advanced_agent.daemon "$@"
